# Base URL of the deployed site — used for SEO metadata, sitemap, RSS and OG images.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: site owner identity, used across metadata, About page and JSON-LD.
NEXT_PUBLIC_AUTHOR_NAME="Your Name"
NEXT_PUBLIC_AUTHOR_TWITTER="@yourhandle"
NEXT_PUBLIC_GITHUB_URL="https://github.com/yourname"

# Optional: contact form delivery. Without these, the API route validates and
# logs submissions instead of emailing them — see src/app/api/contact/route.ts.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com

# Optional: persistent view counts via Upstash Redis (https://upstash.com,
# free tier works fine). Without these, view counts are stored in a local
# JSON file at .data/views.json instead — see src/lib/views.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: comments via giscus (https://giscus.app). Leave blank to hide comments.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
